# ==============================================================================
# CREAMS - Community-based Rehabilitation Management System
# Environment Configuration Template
# ==============================================================================
# 
# Copy this file to .env and customize for your environment
# Never commit your .env file to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="CREAMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cream
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# SESSION & CACHE
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_DRIVER=file
CACHE_PREFIX=creams

# ------------------------------------------------------------------------------
# QUEUES & BROADCASTING
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=log
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# EXTERNAL SERVICES
# ------------------------------------------------------------------------------

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Memcached Configuration
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# ------------------------------------------------------------------------------
# MAIL CONFIGURATION
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@creams.edu.my
MAIL_FROM_NAME="CREAMS System"

# ------------------------------------------------------------------------------
# CLOUD STORAGE (AWS S3)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# REAL-TIME BROADCASTING (Pusher)
# ------------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

# ------------------------------------------------------------------------------
# FRONTEND BUILD (Vite)
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------------------------------------------------------------------------------
# CREAMS SPECIFIC SETTINGS
# ------------------------------------------------------------------------------
CREAMS_VERSION=1.0.0
CREAMS_MAINTENANCE_MODE=false
MAX_FILE_UPLOAD_SIZE=10
MAX_IMAGE_UPLOAD_SIZE=5

# Security Settings
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=60
PASSWORD_MIN_LENGTH=8
#!/bin/bash
# Pre-commit hook: block commits containing secrets or PII patterns
# Install: git config core.hooksPath .githooks

RED='\033[0;31m'
NC='\033[0m'

PATTERNS=(
    'DB_PASSWORD=.+'
    'API_KEY=.+'
    'API_SECRET=.+'
    'AWS_SECRET_ACCESS_KEY=.+'
    'PRIVATE_KEY'
    'BEGIN RSA PRIVATE'
    'BEGIN DSA PRIVATE'
    'BEGIN EC PRIVATE'
    'password.*=.*[A-Za-z0-9@#$%^&*]{8,}'
    '[0-9]{6}-[0-9]{2}-[0-9]{4}'
)

PATTERN_NAMES=(
    'Database password'
    'API key'
    'API secret'
    'AWS secret key'
    'Private key reference'
    'RSA private key'
    'DSA private key'
    'EC private key'
    'Hardcoded password'
    'Malaysian IC number pattern'
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FOUND=0

# Path-based blocklist for real-data artefacts. These files (centre photos,
# invoices, DB dumps) carry real PDPA data but contain no IC/password literals,
# so the content-pattern loop below would not catch them. Block by path.
BLOCKED_PATHS=$(echo "$STAGED_FILES" | grep -E '^Archive/Legacy_Exports/IRL_Files/|^Archive/Legacy_Exports/irl_reference_materials_DUPLICATE/|(^|/)real_data_backup\.json$')
if [ -n "$BLOCKED_PATHS" ]; then
    echo -e "${RED}BLOCKED: Real-data artefacts must not be committed (PDPA)${NC}"
    echo ""
    echo "$BLOCKED_PATHS" | while read -r file; do
        echo "    $file"
    done
    echo ""
    echo "These paths are gitignored. Keep them on local disk only."
    exit 1
fi

for i in "${!PATTERNS[@]}"; do
    # Exclude docs/ from code-pattern checks (password, key patterns) — docs contain code examples.
    # IC pattern still applies to docs/ since that is a PDPA requirement.
    # Exclude database/seeders/IRLSeeder.php from ALL pattern checks — it is the acknowledged
    # real-data seeder, hard-gated to local-only via APP_ENV check inside the seeder. See
    # docs/04_Deployment_Guides/STAGING_SEED_POLICY.md for the policy that makes this safe.
    if [[ "${PATTERNS[$i]}" != *'[0-9]{6}'* ]]; then
        # Exclude docs/ and resources/views/ from code-pattern checks — both contain
        # UI text and code examples that legitimately match "password" patterns.
        # IC pattern still applies to docs/ (PDPA). views/ IC exclusion is below.
        # app/Http/Controllers/MainController.php contains validation error
        # message strings (e.g. 'Password must be at least 8 characters.')
        # that match the password pattern but are not credentials.
        # Archive/ is historical evidence (UAT result JSONs capture page HTML
        # such as input type="password" and screenshot filenames like
        # Admin_wrong_password.png). Code-pattern checks excluded; the IC
        # pattern (PDPA) still applies to Archive/.
        # tests/ contain fixture credentials only (factory bcrypt('password'),
        # seeded UAT logins — same literals as the tracked global-setup.ts).
        # automation/ is audit documentation: it discusses DB_PASSWORD
        # remediation with redacted placeholders that still match the regex.
        # The IC (PDPA) pattern below still applies to automation/.
        # app/Http/Controllers/AdminController.php contains password-management
        # idioms only (Hash::make, validation rules) — no hardcoded credentials.
        MATCHES=$(echo "$STAGED_FILES" | xargs grep -lnE "${PATTERNS[$i]}" 2>/dev/null | grep -v '.githooks/' | grep -v '.env.example' | grep -v '^docs/' | grep -v '^resources/views/' | grep -v '^Archive/' | grep -v '^tests/' | grep -v '^automation/' | grep -v '^database/seeders/IRLSeeder\.php$' | grep -v '^app/Http/Controllers/MainController\.php$' | grep -v '^app/Http/Controllers/Auth/ForgotPasswordController\.php$' | grep -v '^app/Http/Controllers/AdminController\.php$' | grep -v '^\.claude/')
    else
        MATCHES=$(echo "$STAGED_FILES" | xargs grep -lnE "${PATTERNS[$i]}" 2>/dev/null | grep -v '.githooks/' | grep -v '.env.example' | grep -v '^database/seeders/IRLSeeder\.php$')
    fi
    if [ -n "$MATCHES" ]; then
        if [ "$FOUND" -eq 0 ]; then
            echo -e "${RED}BLOCKED: Potential secrets detected in staged files${NC}"
            echo ""
        fi
        echo -e "${RED}  [${PATTERN_NAMES[$i]}]${NC}"
        echo "$MATCHES" | while read -r file; do
            echo "    $file"
        done
        echo ""
        FOUND=1
    fi
done

if [ "$FOUND" -eq 1 ]; then
    echo "Remove secrets before committing, or use: git commit --no-verify (with justification)"
    exit 1
fi

exit 0

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let Laravel handle the homepage directly.
    RewriteRule ^$ index.php [L]

    # Serve real files/directories from public/, but keep the exact
    # /letters module route inside Laravel instead of treating it as
    # the public/letters storage directory.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/letters/?$
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Route everything else through Laravel's front controller.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^ index.php [L]
</IfModule>

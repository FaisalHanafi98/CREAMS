# ==============================================================================
# CREAMS - Community-based Rehabilitation Management System
# Environment Configuration File
# ==============================================================================
# 
# WARNING: This file contains sensitive information. Never commit to version control.
# Copy this file to .env and customize for your environment.
# 
# For production deployment, ensure all sensitive values are properly secured.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="CREAMS"
APP_ENV=local
APP_KEY=base64:uUcj42hi8hXEiiObRSiqq2K/VQc8ZaFHEvmlVOlRj1Y=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

# Application locale and fallback
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ------------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Daily log rotation (recommended for production)
# LOG_CHANNEL=daily
# LOG_LEVEL=info

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cream
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Database connection pool settings (for production)
# DB_CONNECTION_TIMEOUT=60
# DB_READ_WRITE_TIMEOUT=60

# ------------------------------------------------------------------------------
# SESSION CONFIGURATION
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# For production, consider using database or redis for sessions
# SESSION_DRIVER=database
# SESSION_CONNECTION=session

# ------------------------------------------------------------------------------
# CACHE CONFIGURATION
# ------------------------------------------------------------------------------
CACHE_DRIVER=file
CACHE_PREFIX=creams

# For production, consider using Redis or Memcached
# CACHE_DRIVER=redis
# CACHE_PREFIX=creams_prod

# ------------------------------------------------------------------------------
# QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=sync

# For production, use database or Redis queues
# QUEUE_CONNECTION=database
# QUEUE_FAILED_DRIVER=database

# ------------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# For production file storage
# FILESYSTEM_DISK=public
# Or use cloud storage like AWS S3

# ------------------------------------------------------------------------------
# BROADCASTING CONFIGURATION
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=log

# For real-time features, configure Pusher or similar
# BROADCAST_DRIVER=pusher

# ------------------------------------------------------------------------------
# MAIL CONFIGURATION
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-app-specific-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@creams.edu.my
MAIL_FROM_NAME="CREAMS System"

# Alternative: Use Malaysia-based SMTP (recommended for production)
# MAIL_HOST=smtp.exabytes.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Redis Cluster (for production scaling)
# REDIS_CLUSTER=false
# REDIS_PREFIX=creams

# ------------------------------------------------------------------------------
# MEMCACHED CONFIGURATION
# ------------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# ------------------------------------------------------------------------------
# AWS S3 CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# ------------------------------------------------------------------------------
# PUSHER CONFIGURATION (Real-time Broadcasting)
# ------------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

# ------------------------------------------------------------------------------
# VITE CONFIGURATION (Frontend Build)
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# JWT Settings (if using JWT authentication)
# JWT_SECRET=your-jwt-secret-key
# JWT_TTL=60
# JWT_REFRESH_TTL=20160

# Rate limiting (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=60

# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# ------------------------------------------------------------------------------
# CREAMS SPECIFIC CONFIGURATION
# ------------------------------------------------------------------------------
# System-specific settings
CREAMS_VERSION=1.0.0
CREAMS_MAINTENANCE_MODE=false
CREAMS_REGISTRATION_ENABLED=true
CREAMS_EMAIL_VERIFICATION=true

# File upload limits (in MB)
MAX_FILE_UPLOAD_SIZE=10
MAX_IMAGE_UPLOAD_SIZE=5

# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Integration settings
IIUM_INTEGRATION_ENABLED=false
IIUM_API_ENDPOINT=
IIUM_API_KEY=

# Notification settings
NOTIFICATION_CHANNELS=mail,database
NOTIFICATION_QUEUE=default

# ------------------------------------------------------------------------------
# DEVELOPMENT ONLY SETTINGS
# ------------------------------------------------------------------------------
# These should be disabled in production

# Debug toolbar (Laravel Debugbar)
DEBUGBAR_ENABLED=true

# Query logging
LOG_QUERIES=false
SLOW_QUERY_THRESHOLD=500

# Fake mail (for development)
# MAIL_MAILER=log

# ------------------------------------------------------------------------------
# ENVIRONMENT SPECIFIC OVERRIDES
# ------------------------------------------------------------------------------
# Uncomment and modify based on your environment

# === PRODUCTION SETTINGS ===
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=database
# MAIL_MAILER=smtp

# === STAGING SETTINGS ===
# APP_ENV=staging
# APP_DEBUG=false
# LOG_LEVEL=info

# === TESTING SETTINGS ===
# APP_ENV=testing
# DB_DATABASE=cream_testing
# CACHE_DRIVER=array
# QUEUE_CONNECTION=sync
# MAIL_MAILER=array